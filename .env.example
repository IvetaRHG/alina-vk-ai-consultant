# ============================================================
# Шаблон переменных окружения.
# Скопируйте файл в .env и заполните значения САМИ.
# В этом файле не должно быть реальных ключей и токенов.
# ============================================================

# ---------- ВКонтакте ----------

# Ключ доступа сообщества ВКонтакте (права: управление сообществом,
# сообщения сообщества). Как получить — см. README.md, раздел «ВКонтакте».
VK_TOKEN=

# Числовой ID сообщества без минуса. Например: 123456789.
VK_GROUP_ID=


# ---------- GigaChat API ----------

# Ключ авторизации GigaChat API (Authorization Key) из личного кабинета
# Studio. Это строка вида Base64(client_id:client_secret).
GIGACHAT_AUTH_KEY=

# Версия API: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B (юрлица
# по платным пакетам) или GIGACHAT_API_CORP (юрлица, pay-as-you-go).
# Если оставить пустым, будет использовано GIGACHAT_API_PERS.
GIGACHAT_SCOPE=

# Модель GigaChat. Если оставить пустым, будет использовано GigaChat-2.
# Другие варианты: GigaChat-2-Pro, GigaChat-2-Max.
GIGACHAT_MODEL=

# Базовый адрес API. Если оставить пустым:
# https://api.giga.chat/v1
GIGACHAT_BASE_URL=

# Адрес получения access token. Если оставить пустым:
# https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_OAUTH_URL=

# Проверять ли SSL-сертификат GigaChat. true/false.
# false допустим только для локальной разработки, если сертификаты
# НУЦ Минцифры не установлены. В рабочем окружении — true.
GIGACHAT_VERIFY_SSL=

# Путь к файлу корневого сертификата НУЦ Минцифры (PEM/CRT).
# Если сертификат установлен в систему, можно оставить пустым.
GIGACHAT_CA_BUNDLE=


# ---------- Заявка в отдел продаж ----------

# Ссылка на форму заявки (или страницу записи на консультацию).
# Бот показывает её как кнопку «Оставить заявку».
SALES_FORM_URL=

# Контакт менеджера, который бот называет, если не может ответить.
# Например: care@zerocoder.ru или @username. Если пусто, бот
# использует контакты из базы знаний.
MANAGER_CONTACT=


# ---------- Необязательные настройки ----------

# Сколько последних сообщений диалога передавать в GigaChat.
# Если пусто — 12.
MAX_HISTORY_MESSAGES=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR. Если пусто — INFO.
LOG_LEVEL=
